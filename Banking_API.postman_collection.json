				{
					"name": "Register Customer",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.customerId) {",
									"    pm.environment.set(\"customer_id\", jsonData.customerId);",
									"    console.log(\"Saved customer_id:\", jsonData.customerId);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"Ngozi\",\n    \"lastName\": \"Eze\",\n    \"email\": \"ngozi.eze{{$randomInt}}@example.com\",\n    \"phone\": \"+234803{{$randomInt}}\",\n    \"password\": \"SecurePass123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						},
						"description": "Registers a new customer profile, hashes password with bcrypt (12 rounds), and sends a 6-digit verification OTP."
					},
					"response": []
				},
				{
					"name": "Verify OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"var jsonData = pm.response.json();",
									"if (jsonData.accessToken) {",
									"    pm.environment.set(\"jwt_token\", jsonData.accessToken);",
									"    console.log(\"Saved jwt_token\");",
									"}",
									"if (jsonData.customer && jsonData.customer.id) {",
									"    pm.environment.set(\"customer_id\", jsonData.customer.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
