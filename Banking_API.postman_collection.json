						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"ngozi.eze@example.com\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/verify-otp",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						},
