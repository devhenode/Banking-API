// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CustomerStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountType {
  SAVINGS
  CURRENT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum JournalEntryType {
  DEPOSIT
  TRANSFER
  FEE
  REVERSAL
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  LOGIN
}


model Customer {
  id         String         @id @default(uuid(7)) @db.Uuid
  email      String?        @unique
  phone      String?        @unique
  firstName  String         @map("first_name")
  lastName   String         @map("last_name")
  status     CustomerStatus @default(PENDING_VERIFICATION)
  kycTier    Int            @default(0) @map("kyc_tier")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  accounts   Account[]
  credential Credential?
  otpCodes   OtpCode[]     

  @@map("customers")
}

model Account {
  id            String        @id @default(uuid(7)) @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  accountNumber String        @unique @map("account_number") @db.Char(10)
  currency      String        @default("NGN") @db.Char(3)
  type          AccountType
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  closedAt      DateTime?     @map("closed_at") @db.Timestamptz(3)
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        AccountStatus @default(ACTIVE)

  ledgerAccount LedgerAccount?

  @@index([customerId])
  @@map("accounts")
}

model LedgerAccount {
  id        String            @id @default(uuid(7)) @db.Uuid
  accountId String?           @unique @map("account_id") @db.Uuid
  code      String?           @unique
  type      LedgerAccountType
  currency  String            @db.Char(3)
  balance   BigInt            @default(0)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  account Account?     @relation(fields: [accountId], references: [id], onDelete: Restrict)
  lines   LedgerLine[]

  @@map("ledger_accounts")
}

model JournalEntry {
  id          String           @id @default(uuid(7)) @db.Uuid
  type        JournalEntryType
  description String?
  reversesId  String?          @unique @map("reverses_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  lines      LedgerLine[]
  reverses   JournalEntry? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("Reversal")

  @@map("journal_entries")
}

model LedgerLine {
  id              String         @id @default(uuid(7)) @db.Uuid
  journalEntryId  String         @map("journal_entry_id") @db.Uuid
  ledgerAccountId String         @map("ledger_account_id") @db.Uuid
  direction       EntryDirection
  amount          BigInt
  currency        String         @db.Char(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  journalEntry  JournalEntry  @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([ledgerAccountId, createdAt])
  @@map("ledger_lines")
}

model Credential {
  id           String   @id @default(uuid(7)) @db.Uuid
  customerId   String   @unique @map("customer_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("credentials")
}

model OtpCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  codeHash   String    @map("code_hash")
  purpose    OtpPurpose
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("otp_codes")

  @@index([customerId])
}
